{
  "name": "chromium-agentic-search",
  "version": "1.0.0",
  "private": true,
  "description": "Cloud-deployable chat service for answering questions about Chromium changes",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w @chromium-search/web",
    "dev:all": "npm run dev:web & npm run dev",
    "build": "npm run build:shared && npm run build:tools && npm run build:agent && npm run build:api && npm run build:web",
    "build:shared": "npm run build -w @chromium-search/shared",
    "build:tools": "npm run build -w @chromium-search/tools",
    "build:agent": "npm run build -w @chromium-search/agent",
    "build:api": "npm run build -w @chromium-search/api",
    "build:web": "npm run build -w @chromium-search/web",
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo",
    "rebuild": "npm run clean && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docker:up": "docker-compose --env-file ./.env -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker-compose --env-file ./.env -f infra/docker/docker-compose.yml down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
