# Copy this file to .env and fill in the values before running the application
OPENAI_API_KEY=sk-...
# Set if using an alternate OpenAI-compatible endpoint (for Azure, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPLETION_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
# Where chat data and embeddings will be stored
DATA_DIR=data
# Optional: control how many commits to send into the LLM context
MAX_CONTEXT_COMMITS=5
