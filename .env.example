# Chromium Agentic Search Service - Environment Configuration

# =============================================================================
# Server Configuration
# =============================================================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chromium_search

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
# Redis connection URL
REDIS_URL=redis://localhost:6379
# Enable Redis caching (set to false to use in-memory cache)
REDIS_ENABLED=false

# =============================================================================
# OpenAI Configuration
# =============================================================================
# Your OpenAI API key (required for LLM features)
OPENAI_API_KEY=sk-your-api-key-here
# Custom base URL for OpenAI-compatible APIs (optional)
# Use this for Azure OpenAI, local LLMs (Ollama, vLLM), or other OpenAI-compatible providers
# Examples:
#   - Azure: https://your-resource.openai.azure.com
#   - Ollama: http://localhost:11434/v1
#   - vLLM: http://localhost:8000/v1
OPENAI_BASE_URL=
# Model for fast operations (query classification, ranking)
OPENAI_FAST_MODEL=gpt-4o-mini
# Model for complex operations (answer synthesis)
OPENAI_STRONG_MODEL=gpt-4o

# =============================================================================
# Gitiles Configuration
# =============================================================================
# Base URL for Gitiles
GITILES_BASE_URL=https://chromium.googlesource.com
# Repository path
GITILES_REPO_PATH=/chromium/src
# Concurrent requests to Gitiles
GITILES_CONCURRENCY=4
# Retry configuration
GITILES_RETRY_COUNT=3
GITILES_RETRY_DELAY_MS=1000

# =============================================================================
# Budget Configuration
# =============================================================================
# Maximum tool calls per agent run
MAX_TOOL_CALLS_PER_RUN=12
# Maximum bytes fetched per run (20MB default)
MAX_TOTAL_BYTES_PER_RUN=20000000
# Maximum diff lines per commit
MAX_DIFF_LINES_PER_COMMIT=800
# Maximum file content bytes
MAX_FILE_BYTES=204800
# Run timeout in milliseconds (110 seconds)
RUN_TIMEOUT_MS=110000
# Default maximum commits to fetch
MAX_COMMITS_DEFAULT=7000

# =============================================================================
# Cache Configuration (TTL in seconds)
# =============================================================================
# Commit list cache (30 minutes)
CACHE_TTL_COMMIT_LIST=1800
# Commit details cache (7 days - immutable)
CACHE_TTL_COMMIT_DETAILS=604800
# File content cache (30 days - immutable)
CACHE_TTL_FILE_CONTENT=2592000

# =============================================================================
# Ranking Configuration
# =============================================================================
# Top N commits for heuristic ranking
TOP_N_HEURISTIC=100
# Top K commits for deep dive
TOP_K_DEEP_DIVE=10

# =============================================================================
# Security Configuration
# =============================================================================
# Maximum input size in bytes (16KB)
MAX_INPUT_SIZE_BYTES=16384
# Allowed Gitiles hosts (comma-separated)
ALLOWED_GITILES_HOSTS=chromium.googlesource.com

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Pretty print logs (development only)
LOG_PRETTY=true

# =============================================================================
# Debug Configuration
# =============================================================================
# Include debug info in responses
DEBUG_ENABLED=true

# =============================================================================
# Admin Configuration
# =============================================================================
# Password for admin panel access
ADMIN_PASSWORD=chromium-admin
