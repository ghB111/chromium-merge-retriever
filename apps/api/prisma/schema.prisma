// Prisma schema for Chromium Agentic Search Service

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Session table for storing chat sessions
model Session {
  id            String    @id @default(uuid())
  rangeEnabled  Boolean   @default(true)
  startSha      String?
  endSha        String?
  pathScope     String[]  @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  messages      Message[]
  runs          AgentRun[]
}

// Message table for storing chat messages
model Message {
  id        String   @id @default(uuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // 'user' | 'assistant'
  content   String
  createdAt DateTime @default(now())
  runId     String?  // Associated agent run for assistant messages

  @@index([sessionId])
}

// AgentRun table for storing agent run metadata
model AgentRun {
  id             String   @id @default(uuid())
  sessionId      String
  session        Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  queryHash      String   // Hash of the user query
  status         String   // 'running' | 'completed' | 'failed'
  durationMs     Int?
  toolCallCount  Int      @default(0)
  bytesUsed      Int      @default(0)
  errorMessage   String?
  createdAt      DateTime @default(now())
  completedAt    DateTime?
  
  llmCalls       LlmCall[]

  @@index([sessionId])
  @@index([createdAt])
}

// LLM Call table for storing prompts and responses sent to LLMs
model LlmCall {
  id             String   @id @default(uuid())
  runId          String
  run            AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  callType       String   // 'query_classification' | 'ranking' | 'answer_synthesis' | 'agent_exploration' | 'other'
  model          String   // Model name used
  systemPrompt   String   @db.Text // System prompt sent
  userPrompt     String   @db.Text // User prompt sent
  response       String   @db.Text // LLM response
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  latencyMs      Int      @default(0)
  toolCalls      Json?    // For agent_exploration: array of {name, arguments, result}
  createdAt      DateTime @default(now())

  @@index([runId])
  @@index([createdAt])
}

// Pre-saved commit ranges configured by admin
model PreSavedRange {
  id            String   @id @default(uuid())
  name          String   // Human-readable name for the range
  gitilesUrl    String   @unique // Original Gitiles URL
  repoBaseUrl   String   // Parsed repo base URL
  startSha      String   // Start of the range (can be SHA or version tag)
  endSha        String   // End of the range (can be SHA or version tag)
  
  // Download status
  downloadStatus  String   @default("pending") // 'pending' | 'downloading' | 'completed' | 'error'
  downloadProgress Int     @default(0) // Number of commits downloaded
  totalCommits    Int?     // Total commits in range (known after first fetch)
  lastDownloadedSha String? // Last successfully downloaded commit SHA (for resume)
  errorMessage    String?  // Error message if download failed
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  downloadStartedAt DateTime?
  downloadCompletedAt DateTime?

  @@index([downloadStatus])
}
